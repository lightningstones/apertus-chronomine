# ==============================================================================
# ChronoMine AI — Configuration Environment Variables
# ==============================================================================

# Mode d'exécution du fournisseur Apertus :
# - 'mock_offline' : Mode autonome sans GPU ni internet (idéal pour tester/développer en local)
# - 'cscs'         : Mode officiel connecté à l'API CSCS (Swiss Sovereign Cloud)
# - 'ollama'       : Mode local Ollama (si déployé sur le serveur on-premise)
APERTUS_PROVIDER=mock_offline

# Configuration API CSCS (Swiss National Supercomputing Centre)
APERTUS_BASE_URL=https://api.inference.cscs.ch/v1
APERTUS_API_KEY=your_cscs_api_key_here
APERTUS_MODEL=swiss-ai/Apertus-v1.5-8B

# Configuration Serveur
HOST=0.0.0.0
PORT=8000
