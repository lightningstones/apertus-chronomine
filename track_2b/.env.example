# ==============================================================================
# ChronoMine AI — Configuration Environment Variables
# ==============================================================================

# Mode d'exécution du fournisseur Apertus :
# - 'swisscom'     : Mode officiel Swisscom AI Platform (Swiss {ai} Weeks Hackathon)
# - 'cscs'         : Mode officiel CSCS (Swiss National Supercomputing Centre)
# - 'mock_offline' : Mode autonome sans GPU ni internet (démos air-gapped / tests rapides)
# - 'ollama'       : Mode local Ollama (si déployé sur serveur on-premise)
APERTUS_PROVIDER=swisscom

# Option 1: Configuration Swisscom AI Platform (Apertus 1.5 70B)
APERTUS_BASE_URL=https://api.swisscom.com/products/swiss-ai-weeks/apertus-1.5-70b/v1
APERTUS_API_KEY=your_swisscom_api_key_here
APERTUS_MODEL=swiss-ai/Apertus-v1.5-70B

# Option 2: Configuration CSCS (Apertus 1.5 8B / 70B)
# APERTUS_BASE_URL=https://api.inference.cscs.ch/v1
# APERTUS_API_KEY=your_cscs_api_key_here
# APERTUS_MODEL=swiss-ai/Apertus-v1.5-8B

# Configuration Serveur
HOST=0.0.0.0
PORT=8000
